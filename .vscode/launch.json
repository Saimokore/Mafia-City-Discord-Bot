{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debuggar Bot (TSX)",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "tsx"
            ],
            "args": [
                "${workspaceFolder}/index.ts"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        }
    ]
}