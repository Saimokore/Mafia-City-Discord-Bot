// npx prisma db push
// npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model GuildConfig {
  guildId        String   @id
  canalDiurnoId  String?
  canalAnuncioId String?
  prefix         String   @default("!")
  createdAt      DateTime @default(now())

  partida Partida?
}

model Partida {
  id    String      @id @default(uuid())

  guildId String    @unique
  guild GuildConfig @relation(fields: [guildId], references: [guildId])

  status     String @default("LOBBY")
  etapaAtual Int    @default(1) // Em qual rodada estamos

  criadoEm     DateTime  @default(now())
  finalizadoEm DateTime? // Preenchido quando o jogo acaba

  players Player[]

  @@unique([guildId, id])
}

model Player {
  id String @id @default(uuid())

  guildId String
  partida   Partida @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userChat String?

  userId   String
  username String

  cargo       String?
  estaVivo    Boolean      @default(true)

  habilidades Habilidade[]
  alertas     Alerta[]
  cartas      Carta[]

  protecao    Int     @default(0) // Prot Invencibilidade(5) > Obliteracao(4) > Prot Poderosa (3) > Ataque Poderoso(2) > Prot Basica (1) > Ataque Basico (0)
  quantCartas Int     @default(3)
  distrito    Int     @default(0)

  status String @default("")
  marcas String @default("")
  items  String @default("")

  actions Action[]

  @@unique([guildId, userId])
}

model Alerta {
  id        String @id @default(uuid())
  guildId String
  userId    String?
  etapa     Int

  alerta   String

  criadoEm DateTime @default(now())

  player   Player?  @relation(fields: [userId], references: [id])
}

model Carta {
  id        String @id @default(uuid())
  userId    String
  guildId String

  destinatario String
  mensagem     String

  player Player? @relation(fields: [userId, guildId], references: [userId, guildId])
}

model Action {
  id        String @id @default(uuid())
  userId    String
  guildId String

  etapa        Int
  habilidadeId String
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id])
  alvo         Alvo[]

  player Player @relation(fields: [userId, guildId], references: [userId, guildId])

  @@unique([guildId, userId, habilidadeId])
}

model Alvo {
  id     String @id @default(uuid())
  alvoId String

  actionId String
  action   Action @relation(fields: [actionId], references: [id])
}

model Habilidade {
  id     String @id @default(uuid())
  nome   String
  uso    Int
  status String @default("DISPONIVEL") // por enquanto "IMPEDIDA" ou "DISPONIVEL"

  userId    String
  guildId String

  actionId String
  player   Player   @relation(fields: [userId, guildId], references: [userId, guildId])
  actions  Action[]

  @@unique([guildId, userId, actionId])
}

model Oferta {
  id        String @id @default(uuid())
  guildId String

  emissorId String
  alvoId    String

  habilidade String
  status     String @default("PENDENTE") // PENDENTE, ACEITA, RECUSADA
  etapa      Int

  criadoEm DateTime @default(now())

  @@unique([guildId, emissorId, alvoId, habilidade])
}
