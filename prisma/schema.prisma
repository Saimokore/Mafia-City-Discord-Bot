// npx prisma db push
// npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model GuildConfig {
  guildId        String   @id
  canalDiurnoId  String?
  canalAnuncioId String?
  prefix         String   @default("!")
  createdAt      DateTime @default(now())

  partida Partida[]
}

model Partida {
  id String @id @default(uuid())

  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  status     String @default("LOBBY")
  etapaAtual Int    @default(0) // Em qual rodada estamos

  criadoEm     DateTime  @default(now())
  finalizadoEm DateTime? // Preenchido quando o jogo acaba

  players Player[]
  eventos Evento[]
  actions Action[]

  @@unique([guildId])
}

model Player {
  id String @id @default(uuid())

  guildId String
  partida Partida @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  userChat String?

  userId   String
  username String

  cargo    String?
  estaVivo Boolean @default(true)

  habilidades Habilidade[]
  itens       Item[]
  alertas     Alerta[]
  cartas      Carta[]
  ofertas     Oferta[]

  actionsDono Action[] @relation("ActionsDono")

  dadosExtra String @default("{}") // JSON string com dados específicos do cargo (ex: número de vezes que usou a habilidade) extremamente importante

  protecao      Int @default(0)
  protecaoInata Int @default(0)

  quantCartas Int @default(3)
  distrito    Int @default(0)

  status String @default("{}") // JSON string - Obliterado vem aqui tbm
  marcas String @default("{}") // JSON string

  eventosCausados Evento[]     @relation("EventosCausados")
  eventosSofridos EventoAlvo[] @relation("EventosSofridos")

  @@unique([guildId, userId])
}

model Alerta {
  id String @id @default(uuid())

  guildId String
  userId  String

  etapa  Int
  alerta String

  criadoEm DateTime @default(now())

  player Player @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)

  @@unique([guildId, userId, etapa, alerta])
}

model Carta {
  id      String @id @default(uuid())
  userId  String
  guildId String

  destinatario String
  mensagem     String

  player Player @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)
}

model Action {
  id             String   @id @default(uuid())
  partidaId      String
  partida        Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  donoId         String
  dono           Player   @relation("ActionsDono", fields: [donoId], references: [id], onDelete: Cascade)
  
  etapa          Int      // etapa em que o action deve ser processado
  prioridade     Int      // quais actions são executados primeiro
  
  status         String   @default("ATIVO") // ATIVO, PROCESSADO, CANCELADO
  tipo           String   // AO_AVANCAR_ETAPA, AO_MORRER...
  
  habilidadeId   String?  // se for atrelado a uma habilidade
  habilidade     Habilidade? @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)
  
  origemEventoId String?  // se ele foi criado por um evento

  payload        String   @default("{}") // JSON contendo as variaveis (alvo_um, palpite, etc)
  criadoEm       DateTime @default(now())

  @@index([partidaId, etapa, status])
}

model Evento {
  id   String @id @default(uuid())
  tipo String // AO_USAR, ATACAR, AO_MORRER..

  partidaId String
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)

  etapa Int

  fonteId String? // quem causou (null se for o sistema)
  fonte   Player? @relation("EventosCausados", fields: [fonteId], references: [id], onDelete: Cascade)

  payload String @default("{}") // parametros da acao em JSON

  origemEventoId String?
  origemEvento   Evento?  @relation("CadeiaCausal", fields: [origemEventoId], references: [id], onDelete: Cascade)
  eventosFilhos  Evento[] @relation("CadeiaCausal")

  alvos    EventoAlvo[]
  criadoEm DateTime     @default(now())

  @@index([partidaId, etapa])
}

model EventoAlvo {
  id String @id @default(uuid())

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  alvoId String
  alvo   Player @relation("EventosSofridos", fields: [alvoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, alvoId])
}

model Habilidade {
  id   String @id @default(uuid())
  nome String

  etapa  String
  tipo   String
  uso    Int    @default(10000)
  status String @default("DISPONIVEL") // por enquanto "IMPEDIDA" ou "DISPONIVEL"

  userId  String
  guildId String

  player  Player   @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)
  actions Action[]
  ofertas Oferta[]

  @@unique([guildId, userId, nome, etapa])
}

model Item {
  id   String @id @default(uuid())
  nome String

  etapa  String
  tipo   String
  uso    Int    @default(10000)
  status String @default("DISPONIVEL") // por enquanto "IMPEDIDA" ou "DISPONIVEL"

  userId  String
  guildId String

  player Player @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)

  @@unique([guildId, userId, nome, etapa])
}

model Oferta {
  id      String @id @default(uuid())
  guildId String

  emissorId String // actual id
  alvoId    String

  habilidadeId String

  nomeOferta String
  item       String?
  parametros String? // JSON string com parâmetros específicos da oferta (ex: número de vezes que usou a habilidade) mt importante
  status     String  @default("PENDENTE") // PENDENTE, ACEITA, RECUSADA
  etapa      Int

  criadoEm DateTime @default(now())
  player   Player   @relation(fields: [emissorId], references: [id], onDelete: Cascade)

  habilidade Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@unique([guildId, emissorId, alvoId, etapa, nomeOferta])
}

model Visita {
  id      String @id @default(uuid())
  guildId String
  etapa   Int

  visitanteId String
  visitadoId  String

  distritoVisitante Int?
  distritoVisitado  Int?

  criadoEm DateTime @default(now())

  @@unique([guildId, visitanteId, visitadoId, etapa])
}
