// npx prisma db push
// npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model GuildConfig {
  guildId        String   @id
  canalDiurnoId  String?
  canalAnuncioId String?
  prefix         String   @default("!")
  createdAt      DateTime @default(now())

  partida Partida?
}

model Partida {
  id    String      @id
  guild GuildConfig @relation(fields: [id], references: [guildId])

  status     String @default("LOBBY")
  etapaAtual Int    @default(1) // Em qual rodada estamos

  criadoEm     DateTime  @default(now())
  finalizadoEm DateTime? // Preenchido quando o jogo acaba

  players Player[]
}

model Player {
  id String @id @default(uuid())

  partidaId String
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)

  userChat String?

  userId   String
  username String

  cargo       String?
  habilidades Habilidade[]
  estaVivo    Boolean      @default(true)

  protecao    String?
  cartas      Carta[]
  quantCartas Int     @default(3)
  distrito    Int     @default(0)

  status String @default("")
  marcas String @default("")
  items  String @default("")

  actions Action[]

  @@unique([partidaId, userId])
}

model Carta {
  id        String @id @default(uuid())
  userId    String
  partidaId String

  destinatario String
  mensagem     String

  player Player? @relation(fields: [userId, partidaId], references: [userId, partidaId])
}

model Action {
  id        String @id @default(uuid())
  userId    String
  partidaId String

  etapa        Int
  habilidadeId String
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id])
  alvo         Alvo[]

  player Player @relation(fields: [userId, partidaId], references: [userId, partidaId])

  @@unique([partidaId, userId, habilidadeId])
}

model Alvo {
  id     String @id @default(uuid())
  alvoId String

  actionId String
  action   Action @relation(fields: [actionId], references: [id])
}

model Habilidade {
  id        String @id @default(uuid())
  nome      String
  uso       Int
  status    String @default("DISPONIVEL") // por enquanto "IMPEDIDA" ou "DISPONIVEL"

  userId    String
  partidaId String

  actionId  String
  player    Player   @relation(fields: [userId, partidaId], references: [userId, partidaId])
  actions   Action[]

  @@unique([partidaId, userId, actionId])
}

model Oferta {
  id        String @id @default(uuid())
  partidaId String

  emissorId String
  alvoId    String

  habilidade String
  status     String @default("PENDENTE") // PENDENTE, ACEITA, RECUSADA
  etapa      Int

  criadoEm DateTime @default(now())

  @@unique([partidaId, emissorId, alvoId, habilidade])
}
